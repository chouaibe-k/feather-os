# FeatherLinux Tint2 Taskbar Configuration
# Clean, lightweight bottom panel (~8 MB RAM) with App Launcher, Taskbar, Tray, Battery & Clock

# Backgrounds
rounded = 0
border_width = 0
background_color = #1e222a 95
border_color = #2e3440 100

rounded = 4
border_width = 1
background_color = #3b4252 90
border_color = #4c566a 100

# Panel Layout
panel_items = LTBC
panel_size = 100% 32
panel_margin = 0 0
panel_padding = 4 2 4
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
autohide = 0

# Launcher (Start Button)
launcher_padding = 6 2 6
launcher_background_id = 2
launcher_icon_size = 20
launcher_item_app = /usr/share/applications/rofi.desktop
launcher_item_app = /usr/share/applications/pcmanfm.desktop
launcher_item_app = /usr/share/applications/lxterminal.desktop
launcher_item_app = /usr/share/applications/chromium.desktop

# Taskbar
taskbar_mode = single_desktop
taskbar_padding = 2 2 4
taskbar_background_id = 0
taskbar_active_background_id = 2
task_icon = 1
task_text = 1
task_centered = 0
task_maximum_size = 180 30
task_font = Sans 9
task_font_color = #eceff4 85
task_active_font_color = #ffffff 100

# System Tray (Wi-Fi, Volume)
systray_padding = 4 2 6
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 18

# Battery Status (auto-hides if desktop PC without battery)
battery_low_status = 15
battery_low_cmd = notify-send "Low Battery (15%)" "Plug in your charger soon."
bat1_font = Sans Bold 9
bat2_font = Sans 8
battery_font_color = #a3be8c 100
battery_padding = 6 2
battery_background_id = 0
battery_hide = 101

# Clock
time1_format = %H:%M
time1_font = Sans Bold 9
time2_format = %a %d %b
time2_font = Sans 8
clock_font_color = #eceff4 100
clock_padding = 8 2
clock_background_id = 0
clock_lclick_command = gsimplecal
